# Application
APP_NAME=BrandMarket API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Security
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database
DATABASE_URL=postgresql+asyncpg://brandmarket:brandmarket@127.0.0.1:5433/brandmarket

# Redis
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_LOGIN_PER_MINUTE=5

# S3 / MinIO
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=brandmarket
S3_REGION=us-east-1
S3_USE_SSL=false
# Public URL for the browser (not the internal S3 endpoint).
# Local MinIO: http://localhost:9000/brandmarket
# Render + Cloudflare R2: https://pub-XXXX.r2.dev  (or a custom domain)
# Local disk fallback: http://localhost:8000
FILES_BASE_URL=http://localhost:9000/brandmarket
# Fallback local storage when S3 unavailable
LOCAL_UPLOAD_DIR=./uploads

# File upload limits
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
